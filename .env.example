# Copy this file to .env and fill in the values. .env is git-ignored; never commit real tokens.

# Eco-Movement AFIR feed (Clever, Lidl, Circle K, IONITY and others). Request a token from support@eco-movement.com
ECO_MOVEMENT_TOKEN=
# The feed address (optional; this is the default)
ECO_MOVEMENT_URL=https://nap-dk.eco-movement.com/datex2/v1/locations
